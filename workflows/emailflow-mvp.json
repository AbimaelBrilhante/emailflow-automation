        "jsCode": "const items = $input.all();\nconst failures = items.map(({ json }) => json).filter((item) => item.emailflow_etapa);\nif (failures.length > 0) {\n  const details = failures\n    .map((item) => item.emailflow_etapa + ' | ID do e-mail: ' + item.emailflow_id)\n    .join('\\n');\n  throw new Error('EmailFlow: ' + failures.length + ' falha(s) no lote.\\n' + details);\n}\nreturn [{ json: { mensagens_processadas: items.length } }];"
